# =========================================================
# Enterprise RAG Sandbox & Guardrail Evaluator
# Environment Configuration
# =========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
APP_NAME="RAG Evaluator"
APP_ENV=development                      # development | staging | production
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-random-64-char-string
ENCRYPTION_KEY=change-me-to-a-fernet-key  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------
# Backend Server
# ---------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_LOG_LEVEL=info

# ---------------------------------------------------------
# Frontend
# ---------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RAG Evaluator"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rageval:rageval_password@localhost:5432/rageval
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Production (Amazon RDS)
# DATABASE_URL=postgresql+asyncpg://user:pass@rds-endpoint:5432/rageval

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_CELERY_DB=2

# Production (Amazon ElastiCache)
# REDIS_URL=redis://elasticache-endpoint:6379/0

# ---------------------------------------------------------
# Object Storage (S3 / MinIO)
# ---------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000    # Remove for production AWS S3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=rageval-storage
S3_REGION=us-east-1

# ---------------------------------------------------------
# Celery
# ---------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false           # Set true for testing without worker

# ---------------------------------------------------------
# Authentication
# ---------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ---------------------------------------------------------
# AI Providers (User-configurable per project)
# ---------------------------------------------------------
# These are PLATFORM-LEVEL defaults. Users provide their own keys per project.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------
# Email
# ---------------------------------------------------------
EMAIL_PROVIDER=smtp                       # smtp | sendgrid | ses | resend
EMAIL_FROM_ADDRESS=noreply@rageval.dev
EMAIL_FROM_NAME="RAG Evaluator"

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# SendGrid
SENDGRID_API_KEY=

# AWS SES
SES_REGION=us-east-1
# Uses S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY

# Resend
RESEND_API_KEY=

# ---------------------------------------------------------
# Stripe Billing
# ---------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Plan Price IDs
STRIPE_PRICE_FREE_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_PRICE_USAGE_METERED=

# ---------------------------------------------------------
# Observability
# ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rageval-backend
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=
LOKI_URL=http://localhost:3100

# ---------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10
